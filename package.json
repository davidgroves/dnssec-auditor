    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.58.0",
    "@types/alpinejs": "^3.13.10",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "alpinejs": "^3.14.0"
  }
}
