{
  "title": "DNSSEC Auditor",
  "uid": "dnssec-auditor",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["dnssec"],
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "total",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "query_result(count(dnssec_auditor_zone_state == 1) or vector(0))",
        "query": "query_result(count(dnssec_auditor_zone_state == 1) or vector(0))",
        "regex": "/(\\d+)(?:\\.\\d+)?\\s+\\d+\\s*$/",
        "refresh": 2,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "sort": 0
      },
      {
        "name": "valid",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "query_result(sum(dnssec_auditor_zone_state{state=\"valid\"}) or vector(0))",
        "query": "query_result(sum(dnssec_auditor_zone_state{state=\"valid\"}) or vector(0))",
        "regex": "/(\\d+)(?:\\.\\d+)?\\s+\\d+\\s*$/",
        "refresh": 2,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "sort": 0
      },
      {
        "name": "invalid",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "query_result(sum(dnssec_auditor_zone_state{state=\"invalid\"}) or vector(0))",
        "query": "query_result(sum(dnssec_auditor_zone_state{state=\"invalid\"}) or vector(0))",
        "regex": "/(\\d+)(?:\\.\\d+)?\\s+\\d+\\s*$/",
        "refresh": 2,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "sort": 0
      },
      {
        "name": "unsigned",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "query_result(sum(dnssec_auditor_zone_state{state=\"unsigned\"}) or vector(0))",
        "query": "query_result(sum(dnssec_auditor_zone_state{state=\"unsigned\"}) or vector(0))",
        "regex": "/(\\d+)(?:\\.\\d+)?\\s+\\d+\\s*$/",
        "refresh": 2,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Valid",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dnssec_auditor_zone_state{state=\"valid\"}) or vector(0)",
          "legendFormat": "${valid}/${total}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "name" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Invalid",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dnssec_auditor_zone_state{state=\"invalid\"}) or vector(0)",
          "legendFormat": "${invalid}/${total}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "name" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unsigned",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dnssec_auditor_zone_state{state=\"unsigned\"}) or vector(0)",
          "legendFormat": "${unsigned}/${total}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "name" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error findings",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dnssec_auditor_zone_findings{severity=\"error\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Warning findings",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dnssec_auditor_zone_findings{severity=\"warning\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Verification duration",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dnssec_auditor_verification_duration_seconds_sum[5m]) / rate(dnssec_auditor_verification_duration_seconds_count[5m])",
          "legendFormat": "{{zone}} {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Transfers",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dnssec_auditor_transfers_total[5m])",
          "legendFormat": "{{zone}} {{method}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Zone serials",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "dnssec_auditor_zone_serial",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["zone", "Value"] } } },
        { "id": "organize", "options": { "renameByName": { "Value": "Serial" } } },
        { "id": "sortBy", "options": { "sort": [{ "field": "zone" }] } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Open findings",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "dnssec_auditor_zone_findings > 0",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": { "include": { "names": ["zone", "code", "severity", "Value"] } }
        },
        { "id": "organize", "options": { "renameByName": { "Value": "Count" } } },
        { "id": "sortBy", "options": { "sort": [{ "field": "severity", "desc": true }] } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "NOTIFYs received",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dnssec_auditor_notifies_received_total[5m])",
          "legendFormat": "{{transport}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1 }
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Time until earliest RRSIG expiry",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "dnssec_auditor_zone_rrsig_earliest_expiry_timestamp_seconds - time()",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Process RSS",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"dnssec-auditor\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "bytes"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Go heap",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_alloc_bytes{job=\"dnssec-auditor\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "bytes"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Zone store",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "dnssec_auditor_zone_store_bytes",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "bytes"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Process memory",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"dnssec-auditor\"}",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "process_virtual_memory_bytes{job=\"dnssec-auditor\"}",
          "legendFormat": "Virtual"
        },
        {
          "refId": "C",
          "expr": "go_memstats_heap_alloc_bytes{job=\"dnssec-auditor\"}",
          "legendFormat": "Heap"
        },
        {
          "refId": "D",
          "expr": "dnssec_auditor_zone_store_bytes",
          "legendFormat": "Zone store"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        }
      }
    }
  ]
}
